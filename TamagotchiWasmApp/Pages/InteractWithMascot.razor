<!-- Pages/InteractWithMascot.razor -->
@page "/interact-with-mascot/{nomeMascote}"
@inject IPlayerStateStorage PlayerStateStorage
@inject GptChatCompletionService GptService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@using Microsoft.JSInterop

<h3>Interagir com @nomeMascote</h3>

@if (_mascote != null)
{
    <div class="chat-container">
        <div class="action-buttons">
            <button class="btn btn-link" @onclick="ShowDetails" title="Saber mais">
                <i class="fas fa-info-circle"></i>
            </button>
            <button class="btn btn-link" @onclick="FeedMascot" title="Alimentar">
                <i class="fas fa-utensils"></i>
            </button>
            <button class="btn btn-link" @onclick="PlayWithMascot" title="Brincar">
                <i class="fas fa-gamepad"></i>
            </button>
            <button class="btn btn-link" @onclick="ToggleSleep" title="@(_mascote.EstaDormindo ? "Acordar" : "Dormir")">
                <i class="fas @(_mascote.EstaDormindo ? "fa-sun" : "fa-bed")"></i>
            </button>
            <button class="btn btn-link" @onclick="ViewConversations" title="Conversas">
                <i class="fas fa-history"></i>
            </button>
            <button class="btn btn-link" @onclick="GoBack" title="Voltar">
                <i class="fas fa-arrow-left"></i>
            </button>
        </div>
        <div class="chat-history">
            @{
                var horaRegistroAnterior = (DateTimeOffset?)null;
                @foreach (var registro in _mascote.Historico.OrderBy(h => h.Horario).Take(30))
                {
                    @if (horaRegistroAnterior == null
                        || registro.Horario - horaRegistroAnterior > TimeSpan.FromMinutes(5))
                    {
                        <p><strong>@registro.Horario.ToString("dd/MM/yyyy HH:mm:ss")</strong></p>
                    }
                    @if (registro.Acao != null)
                    {
                        <!-- Mensagem do jogador -->
                        <div class="chat-message user-message">
                            <div class="message-content">
                                @registro.Acao
                            </div>
                        </div>
                    }
                    @if (registro.Mensagem != null)
                    {
                        <!-- Mensagem do mascote -->
                        <div class="chat-message mascot-message">
                            <img src="@_mascote.ImageUrl" alt="@_mascote.Nome" class="mascot-image" />
                            <div class="message-content">
                                @registro.Mensagem
                            </div>
                        </div>
                    }
                    <hr />
                    
                    horaRegistroAnterior = registro.Horario;
                }
            }
        </div>
        <div class="chat-input">
            <div class="input-group">
                <input @bind="_userMessage" placeholder="Digite sua mensagem" class="form-control" />
                <button class="btn @(_isRecording ? "btn-danger" : "btn-secondary")" @onclick="ToggleVoiceInput">
                    <i class="fas @(_isRecording ? "fa-microphone-slash" : "fa-microphone")"></i>
                    @(_isRecording ? "Parar" : "Falar")
                </button>
                @if (_isRecording)
                {
                    <p><em>Escutando...</em></p>
                }
                <button class="btn btn-primary" @onclick="SendMessage" title="Enviar">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </div>
    </div>
}
else
{
    <p>Mascote não encontrado.</p>
}

@code {
    [Parameter]
    public string nomeMascote { get; set; } = string.Empty;

    private PlayerState? _playerState;
    private Tamagotchi? _mascote;
    private string? _userMessage;
    private IJSObjectReference? _module;
    private DotNetObjectReference<InteractWithMascot>? _dotNetObjectRef;
    private bool _isRecording = false;


    protected override async Task OnInitializedAsync()
    {
        _playerState = await PlayerStateStorage.LoadActivePlayerStateAsync();
        _mascote = _playerState?.AdoptedMascots.FirstOrDefault(m => m.Nome == nomeMascote);

        // Carrega o módulo JavaScript
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/speechRecognition.js");

        // Cria uma referência de objeto .NET para permitir chamadas do JavaScript para o .NET
        _dotNetObjectRef = DotNetObjectReference.Create(this);

        // Inicializa o reconhecimento de voz
        await _module.InvokeVoidAsync("initialize", _dotNetObjectRef);
    }

    [JSInvokable]
    public void OnVoiceInputReceived(string recognizedText)
    {
        _userMessage = recognizedText;
        _isRecording = false; // Reseta o estado de gravação
        InvokeAsync(StateHasChanged);
    }
    
    [JSInvokable]
    public void OnVoiceInputError(string error)
    {
        _isRecording = false;
        Console.WriteLine($"Erro no reconhecimento de voz: {error}");
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnVoiceInputEnded()
    {
        _isRecording = false;
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleVoiceInput()
    {
        if (_isRecording)
        {
            await StopVoiceInput();
        }
        else
        {
            await StartVoiceInput();
        }
    }

    private async Task StartVoiceInput()
    {
        if (_module != null)
        {
            _isRecording = true;
            await _module.InvokeVoidAsync("startRecognition");
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopVoiceInput()
    {
        if (_module != null)
        {
            await _module.InvokeVoidAsync("stopRecognition");
        }
        _isRecording = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ShowDetails()
    {
        if (_mascote == null) return;
        NavigationManager.NavigateTo($"/mascot-details/{_mascote.Nome}");
    }

    private async Task FeedMascot()
    {
        await Interact("Alimentar");
    }

    private async Task PlayWithMascot()
    {
        await Interact("Brincar");
    }

    private async Task ToggleSleep()
    {
        if (_mascote == null) return;

        var action = _mascote.EstaDormindo ? "Acordar" : "Dormir";
        _mascote.DormirOuAcordar();
        await Interact(action);
    }

    private void ViewConversations()
    {
        if (_mascote == null) return;

        NavigationManager.NavigateTo($"/mascot-history/{_mascote.Nome}");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/view-mascots");
    }

    private async Task SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(_userMessage))
        {
            await Interact(_userMessage);
            _userMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Interact(string action)
    {
        if (_playerState == null
            || _mascote == null) return;

        var prompt = new PromptAcao
        {
            Acao = action,
            Humor = _mascote.Humor,
            Fome = _mascote.Fome,
            Sono = _mascote.Sono,
            EstaDormindo = _mascote.EstaDormindo
        };

        await GptService.GetGpt4CompletionAsync(_mascote, prompt);
        _mascote.RegistrarHistorico(action);

        // Atualize o estado do mascote se necessário
        await PlayerStateStorage.SavePlayerStateAsync(_playerState);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
        {
            await _module.DisposeAsync();
        }
        if (_dotNetObjectRef != null)
        {
            _dotNetObjectRef.Dispose();
        }
    }
}
