@page "/select-mascot-menu"
@inject NavigationManager NavigationManager
@inject TamagotchiService TamagotchiService
@inject IPlayerStateStorage PlayerStateStorage

<h3>Adotar um Mascote</h3>
<p>@_playerState?.NomeJogador, escolha uma espécie:</p>
<ul>
    @foreach (var mascote in _mascotes)
    {
        <li>
            <img src="@mascote.ImageUrl" alt="@mascote.Nome" class="mascot-image" />
            <button class="btn btn-link" @onclick="() => SelectPokemon(mascote.Nome)">
                @mascote.Nome
            </button>
        </li>
    }
</ul>

@code {
    private PlayerState? _playerState;

    private List<InfoMascote> _mascotes = new();

    protected override async Task OnInitializedAsync()
    {
        _playerState = await PlayerStateStorage.LoadActivePlayerStateAsync();
        _mascotes = TamagotchiService.ListarMascotes().ToList();
    }

    private void SelectPokemon(string mascote)
    {
        NavigationManager.NavigateTo($"/adopt-mascot-menu/{mascote}");
    }
}
